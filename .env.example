# [변경사유]: 카카오톡 PC 수집 — 환경 예시 (쿠키·세션 저장 금지)
# kakao-import-local 경로 (chats/photos 산출)
KAKAO_IMPORT_ROOT=F:/site_kdance/TEST_web/kakao-import-local

# 카톡 사진 다운로드 고정 폴더
KAKAO_DOWNLOAD_DIR=D:/Users/msgu/Documents/카카오톡 받은 파일

# 수집 후 kakao-import 호출 (1=호출, 0=파일만)
KAKAO_COLLECT_RUN_IMPORT=1

LOG_LEVEL=INFO
